<%- include('partials/head', { title }) %>
  <body class="bg-[#fff3f3]">
    <%- include('partials/header') %>

    <main class="bg-[#fff3f3] min-h-[650px] px-6 md:px-8 py-12 md:py-14">
      <section class="max-w-[950px] mx-auto text-center">
        <h1 class="text-[40px] md:text-[48px] leading-none font-black text-[#180707]">
          <%= new Date(year, month - 1).toLocaleString('et-EE', { month: 'long', year: 'numeric' }) %>
        </h1>
        <p class="mt-3 text-xs text-black">Tumedad päevad on vabad. Heledad päevad ei ole valitavad.</p>

        <% if (success) { %>
          <div class="mt-8 mx-auto max-w-[520px] bg-green-100 border border-green-700 text-green-900 px-4 py-3 text-left">
            Broneering salvestati.
          </div>
        <% } %>

        <% if (errors.reservation_date) { %>
          <p class="mt-6 text-red-700"><%= errors.reservation_date %></p>
        <% } %>

        <form action="/reservations" method="post" class="mt-10 md:mt-12" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input id="reservation_date" type="hidden" name="reservation_date" value="<%= values.reservation_date %>" />

          <div class="grid grid-cols-4 sm:grid-cols-7 gap-3 sm:gap-5 justify-center">
            <% days.forEach((calendarDay) => { %>
              <button
                type="button"
                data-date="<%= calendarDay.date %>"
                <%= calendarDay.reserved || calendarDay.past ? 'disabled' : '' %>
                class="reservation-day h-14 w-14 sm:h-20 sm:w-20 rounded-md text-white font-bold <%= calendarDay.reserved || calendarDay.past ? 'bg-[#cdb2cf] cursor-not-allowed text-black/40' : 'bg-[#2c0d20]' %> <%= calendarDay.selected ? 'ring-4 ring-[#8d79c7]' : '' %>"
                aria-label="<%= calendarDay.reserved ? 'reserved day' : calendarDay.past ? 'past day' : 'free day' %> <%= calendarDay.day %>"
              >
                <%= calendarDay.day %>
              </button>
            <% }) %>
          </div>

          <div class="mt-10 mx-auto max-w-[520px] bg-white/50 border border-black/20 p-5 text-left">
            <p id="selected-date-label" class="mb-4 font-bold">
              <% if (values.reservation_date) { %>
                Valitud päev: <%= values.reservation_date %>
              <% } else { %>
                Vali ülevalt vaba päev.
              <% } %>
            </p>

            <label for="name" class="block font-semibold mb-1">Nimi</label>
            <input id="name" name="name" type="text" value="<%= values.name %>" class="w-full border border-black/40 bg-transparent px-3 py-2 mb-1" />
            <%- include('partials/field-error', { errors, field: 'name' }) %>

            <label for="email" class="block font-semibold mb-1 mt-4">Email</label>
            <input id="email" name="email" type="email" value="<%= values.email %>" class="w-full border border-black/40 bg-transparent px-3 py-2 mb-1" />
            <%- include('partials/field-error', { errors, field: 'email' }) %>

            <label for="phone" class="block font-semibold mb-1 mt-4">Telefon</label>
            <input id="phone" name="phone" type="tel" value="<%= values.phone %>" class="w-full border border-black/40 bg-transparent px-3 py-2 mb-1" />
            <%- include('partials/field-error', { errors, field: 'phone' }) %>

            <button type="submit" class="mt-6 bg-[#2c0d20] text-white px-8 py-2 text-sm rounded-sm">
              Broneeri päev
            </button>
          </div>
        </form>
      </section>
    </main>

    <script>
      const dateInput = document.querySelector('#reservation_date');
      const label = document.querySelector('#selected-date-label');
      const buttons = document.querySelectorAll('.reservation-day:not(:disabled)');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          buttons.forEach((item) => item.classList.remove('ring-4', 'ring-[#8d79c7]'));
          button.classList.add('ring-4', 'ring-[#8d79c7]');
          dateInput.value = button.dataset.date;
          label.textContent = `Valitud päev: ${button.dataset.date}`;
        });
      });
    </script>

    <%- include('partials/footer') %>
  </body>
</html>

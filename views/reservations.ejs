<%- include('partials/head', { title }) %>
  <body class="bg-[#fff3f3]">
    <%- include('partials/header') %>

    <main class="bg-[#fff3f3] min-h-[650px] px-6 md:px-8 py-12 md:py-14">
      <section class="max-w-[900px] mx-auto text-center">
        <h1 class="text-[40px] md:text-[48px] leading-none font-black text-[#180707]">june</h1>
        <p class="mt-3 text-xs text-black">free days</p>

        <div class="mt-10 md:mt-12 grid grid-cols-4 sm:grid-cols-7 gap-3 sm:gap-5 justify-center">
          <% for (let day = 1; day <= 28; day += 1) { %>
            <% const free = [1, 4, 10, 13, 16, 18, 24, 28].includes(day); %>
            <button class="h-14 w-14 sm:h-20 sm:w-20 rounded-md <%= free ? 'bg-[#2c0d20]' : 'bg-[#cdb2cf]' %>" aria-label="<%= free ? 'free day' : 'reserved day' %>"></button>
          <% } %>
        </div>

        <a href="/contact" class="mt-10 md:mt-12 inline-block bg-[#2c0d20] text-white px-8 py-2 text-sm rounded-sm">
          Place
        </a>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>

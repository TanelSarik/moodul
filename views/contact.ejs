<%- include('partials/head', { title }) %>
  <body class="bg-[#fff3f3]">
    <%- include('partials/header') %>

    <main class="bg-[#fff3f3] min-h-[650px] px-6 md:px-8 py-16 md:py-24">
      <section class="max-w-[1250px] mx-auto">
        <% if (success) { %>
          <div class="mb-6 max-w-[400px] bg-green-100 border border-green-700 text-green-900 px-4 py-3">
            Aitäh! Sõnum salvestati ja administraator näeb seda admin vaates.
          </div>
        <% } %>

        <form class="w-full max-w-[400px] mx-auto md:mx-0" action="/contact" method="post" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <label class="sr-only" for="name">Nimi</label>
          <input
            id="name"
            name="name"
            type="text"
            value="<%= values.name %>"
            placeholder="name:"
            class="w-full h-10 border border-black/40 bg-transparent px-3 mb-1 text-sm outline-none"
          />
          <%- include('partials/field-error', { errors, field: 'name' }) %>

          <label class="sr-only" for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            value="<%= values.email %>"
            placeholder="Email:"
            class="w-full h-10 border border-black/40 bg-transparent px-3 mt-3 mb-1 text-sm outline-none"
          />
          <%- include('partials/field-error', { errors, field: 'email' }) %>

          <label class="sr-only" for="phone">Telefon</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            value="<%= values.phone %>"
            placeholder="Tel:"
            class="w-full h-10 border border-black/40 bg-transparent px-3 mt-3 mb-1 text-sm outline-none"
          />
          <%- include('partials/field-error', { errors, field: 'phone' }) %>

          <label class="sr-only" for="message">Sõnum</label>
          <textarea
            id="message"
            name="message"
            placeholder="Text goes here"
            class="w-full h-[170px] border border-black/40 bg-transparent px-3 py-2 mt-3 mb-1 text-sm outline-none resize-none"
          ><%= values.message %></textarea>
          <%- include('partials/field-error', { errors, field: 'message' }) %>

          <button type="submit" class="mt-3 bg-[#2c0d20] text-white px-7 py-2 text-xs">
            Saada
          </button>
        </form>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>

      </a>

      <a href="/reservations" class="bg-[#fff3f3] border border-black/40 rounded-md px-3 md:px-4 py-1 text-xs md:text-sm">
        reservations
      </a>
    </div>

    <div class="md:w-1/3 flex justify-center md:justify-end gap-2">
      <a href="/contact" class="bg-[#fff3f3] border border-black/40 rounded-md px-3 md:px-4 py-1 text-xs md:text-sm">

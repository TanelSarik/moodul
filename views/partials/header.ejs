<header class="bg-[#8d79c7] min-h-[72px]">
  <nav class="max-w-[1920px] min-h-[72px] mx-auto px-4 md:px-12 flex flex-col md:flex-row items-center justify-center md:justify-between gap-3 py-3 md:py-0">
    <div class="md:w-1/3 flex justify-center md:justify-start">
      <a href="/">
        <img src="/images/logovaike.png" alt="Midnight Ramen" class="h-10 md:h-12" />
      </a>
    </div>

    <div class="md:w-1/3 flex justify-center gap-2 md:gap-3">
      <a href="/dishes" class="bg-[#fff3f3] border border-black/40 rounded-md px-3 md:px-4 py-1 text-xs md:text-sm">

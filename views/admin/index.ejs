<%- include('../partials/head', { title }) %>
  <body class="bg-slate-100">
    <main class="max-w-6xl mx-auto px-6 py-10">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold">Admin</h1>
          <p class="text-slate-600">Halda roogi, broneeringuid ja kontaktvormi sõnumeid.</p>
        </div>
        <div class="flex gap-3">
          <a href="/" class="border border-slate-900 px-4 py-2">Avaleht</a>
          <form action="/admin/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="bg-slate-900 text-white px-4 py-2" type="submit">Logi välja</button>
          </form>
        </div>
      </div>

      <% if (flash) { %>
        <p class="mt-6 bg-green-100 text-green-900 px-4 py-3"><%= flash %></p>
      <% } %>

      <section class="mt-10 bg-white border border-slate-300 p-5">
        <div class="flex items-center justify-between gap-4 mb-5">
          <h2 class="text-xl font-bold">Road</h2>
          <a href="/admin/dishes/new" class="bg-slate-900 text-white px-4 py-2">Lisa roog</a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b">
                <th class="py-2 pr-4">Nimi</th>
                <th class="py-2 pr-4">Hind</th>
                <th class="py-2 pr-4">Vürtsisus</th>
                <th class="py-2 pr-4">Tegevused</th>
              </tr>
            </thead>
            <tbody>
              <% dishes.forEach((dish) => { %>
                <tr class="border-b">
                  <td class="py-3 pr-4"><%= dish.name %></td>
                  <td class="py-3 pr-4"><%= money(dish.price_cents) %></td>
                  <td class="py-3 pr-4"><%= dish.spiciness %>/5</td>
                  <td class="py-3 pr-4">
                    <div class="flex flex-wrap gap-2">
                      <a href="/dish/<%= dish.slug %>" class="underline">Vaata</a>
                      <a href="/admin/dishes/<%= dish.id %>/edit" class="underline">Muuda</a>
                      <form action="/admin/dishes/<%= dish.id %>/delete" method="post" onsubmit="return confirm('Kustuta roog?')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button class="text-red-700 underline" type="submit">Kustuta</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-10 bg-white border border-slate-300 p-5">
        <h2 class="text-xl font-bold mb-5">Broneeringud</h2>
        <% if (reservations.length === 0) { %>
          <p class="text-slate-600">Broneeringuid pole veel tehtud.</p>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b">
                  <th class="py-2 pr-4">Kuupäev</th>
                  <th class="py-2 pr-4">Nimi</th>
                  <th class="py-2 pr-4">Email</th>
                  <th class="py-2 pr-4">Telefon</th>
                </tr>
              </thead>
              <tbody>
                <% reservations.forEach((reservation) => { %>
                  <tr class="border-b">
                    <td class="py-3 pr-4"><%= reservation.reservation_date %></td>
                    <td class="py-3 pr-4"><%= reservation.name %></td>
                    <td class="py-3 pr-4"><%= reservation.email %></td>
                    <td class="py-3 pr-4"><%= reservation.phone || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <section class="mt-10 bg-white border border-slate-300 p-5">
        <h2 class="text-xl font-bold mb-5">Kontaktvormi sõnumid</h2>
        <% if (messages.length === 0) { %>
          <p class="text-slate-600">Sõnumeid pole veel saadetud.</p>
        <% } %>
        <div class="space-y-4">
          <% messages.forEach((message) => { %>
            <article class="border border-slate-200 p-4">
              <h3 class="font-bold"><%= message.name %> &lt;<%= message.email %>&gt;</h3>
              <% if (message.phone) { %>
                <p class="text-sm text-slate-600">Tel: <%= message.phone %></p>
              <% } %>
              <p class="text-sm text-slate-500"><%= message.created_at %></p>
              <p class="mt-3 whitespace-pre-wrap"><%= message.message %></p>
            </article>
          <% }) %>
        </div>
      </section>
    </main>
  </body>
</html>

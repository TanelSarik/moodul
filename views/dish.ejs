<%- include('partials/head', { title }) %>
  <body class="bg-[#fff3f3]">
    <%- include('partials/header') %>

    <main class="bg-[#fff3f3] px-6 md:px-8 py-16 md:py-24 min-h-[650px]">
      <section class="max-w-[1250px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[55%_45%] gap-10 md:gap-16 lg:gap-20 items-center">
        <div class="order-2 md:order-1 text-center md:text-left">
          <h1 class="text-[36px] md:text-[48px] lg:text-[58px] leading-[1] font-black text-[#180707]">
            <%= dish.name %>
          </h1>

          <p class="mt-6 md:mt-8 max-w-[650px] mx-auto md:mx-0 text-sm md:text-base leading-6 text-black/80">
            <%= dish.description %>
          </p>

          <dl class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <dt class="font-bold">Hind</dt>
              <dd><%= money(dish.price_cents) %></dd>
            </div>
            <div>
              <dt class="font-bold">Vürtsisus</dt>
              <dd><%= dish.spiciness %>/5</dd>
            </div>
            <div>
              <dt class="font-bold">Koostis</dt>
              <dd><%= dish.ingredients %></dd>
            </div>
            <div>
              <dt class="font-bold">Allergeenid</dt>
              <dd><%= dish.allergens || 'Puuduvad' %></dd>
            </div>
          </dl>
        </div>

        <img src="<%= firstImage(dish.images) %>" alt="<%= dish.name %>" class="order-1 md:order-2 h-[320px] sm:h-[420px] lg:h-[520px] w-full object-cover" />
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>

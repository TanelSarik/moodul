<%- include('partials/head', { title }) %>
  <body class="bg-[#fff3f3]">
    <%- include('partials/header') %>

    <main>
      <section class="bg-[#fff3f3] px-6 md:px-8 py-16 md:py-24">
        <div class="max-w-[1920px] mx-auto grid grid-cols-1 lg:grid-cols-[38%_62%] items-center gap-10 lg:gap-8">
          <div class="max-w-[500px] mx-auto lg:mx-0 text-center lg:text-left">
            <h1 class="text-[46px] sm:text-[60px] lg:text-[78px] leading-[0.95] font-black text-[#180707]">
              Enjoy <span class="text-[#8d79c7]">night</span> and day
            </h1>

            <p class="mt-6 text-[15px] leading-6 text-black/70">
              Midnight Ramen brings handmade noodles, rich broth and warm late-night energy into one calm restaurant experience.
            </p>

            <div class="mt-10 flex justify-center lg:justify-start gap-4">
              <a href="/dishes" class="bg-[#2c0d20] text-white px-8 py-3 text-sm rounded-sm">Dishes</a>
              <a href="/reservations" class="border border-[#8d79c7] px-8 py-3 text-sm rounded-sm">Reservations</a>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <img src="/images/hero-1.webp.png" alt="Midnight Ramen restaurant outside" class="h-[380px] sm:h-[500px] lg:h-[650px] w-full object-cover" />
            <img src="/images/hero-2.webp.png" alt="Midnight Ramen interior" class="h-[380px] sm:h-[500px] lg:h-[650px] w-full object-cover" />
            <img src="/images/hero-3.webp.png" alt="Chef cooking ramen" class="h-[380px] sm:h-[500px] lg:h-[650px] w-full object-cover" />
          </div>
        </div>
      </section>

      <section id="story" class="bg-[#8d79c7] px-6 md:px-8 py-20 md:py-28 text-white">
        <div class="max-w-[1600px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
            <img src="/images/ramen-1.webp.png" alt="Restaurant worker" class="h-[360px] md:h-[620px] w-full object-cover" />
            <img src="/images/ramen-2.webp.png" alt="Ramen chef smiling" class="h-[360px] md:h-[620px] w-full object-cover" />
          </div>

          <div class="text-center md:text-left">
            <h2 class="text-4xl md:text-5xl font-bold">Our Story</h2>
            <p class="mt-8 max-w-lg mx-auto md:mx-0 text-sm leading-7 text-white/80">
              Midnight Ramen was created to bring a calm night-time feeling, handmade noodles and rich broth into one place.
            </p>
          </div>
        </div>
      </section>

      <section id="menu" class="bg-[#fff3f3] px-6 md:px-8 py-20 md:py-24">
        <div class="max-w-[1600px] mx-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
            <% dishes.forEach((dish) => { %>
              <article class="text-center">
                <img src="<%= firstImage(dish.images) %>" alt="<%= dish.name %>" class="h-[360px] w-full object-cover" />
                <h3 class="mt-4 font-bold"><%= dish.name %></h3>
                <p class="mt-1 text-sm"><%= money(dish.price_cents) %></p>
                <a href="/dish/<%= dish.slug %>" class="mt-3 inline-block bg-[#2c0d20] text-white px-6 py-2 text-sm rounded-sm">More info</a>
              </article>
            <% }) %>
          </div>
        </div>
      </section>

      <section class="bg-[#fff3f3] px-6 md:px-8 py-20 md:py-24">
        <div class="max-w-[1600px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center">
          <div class="text-center md:text-left">
            <h2 class="text-4xl md:text-5xl font-bold leading-tight">Make your<br />own Ramen</h2>
            <p class="mt-8 max-w-md mx-auto md:mx-0 text-sm leading-7 text-black/70">
              Choose your broth, noodles, toppings and spice level. Build the bowl exactly how you like it.
            </p>
          </div>
          <img src="/images/ramen-3.webp.png" alt="Custom ramen bowl" class="h-[380px] md:h-[620px] w-full object-cover" />
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
